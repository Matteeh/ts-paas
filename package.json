{
  "name": "ts-paas",
  "version": "0.0.0",
  "description": "A small self-hosted PaaS: deploy container images as apps on Docker or rootless Podman, with Caddy ingress, from one CLI.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "paas": "dist/cli.js"
  },
  "scripts": {
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "verify": "tsc -p tsconfig.json && pnpm test",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matteeh/ts-paas.git"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@fission-ai/openspec": "1.13.1",
    "@matteeh/osq": "0.2.1",
    "@types/dockerode": "4.0.1",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "commander": "15.0.0",
    "dockerode": "4.0.12"
  }
}
